PORT=3000
NODE_ENV=development
# Local JSON persistence works with no database. Do not commit runtime-data.
DATA_DIR=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=manas_mitra
# Optional server-only provider credentials. Never put these in browser code.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional additional Indic speech coverage.
SARVAM_API_KEY=
# Keep false for public servers. Authenticated accounts can use cloud AI.
ALLOW_DEMO_AI=false
# Set your HTTPS origin on production hosts behind a trusted proxy.
APP_ORIGIN=
# Optional OpenAI-compatible chat provider override.
AI_API_URL=
AI_API_KEY=
